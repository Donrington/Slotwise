{
  "name": "slotwise-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsc && vitest run --passWithNoTests",
    "test:coverage": "tsc && vitest run --coverage --coverage.include=src/** --coverage.reporter=text",
    "migrate": "tsc && node dist/migrate-cli.js",
    "vercel-build": "tsc && node dist/migrate-cli.js"
  },
  "dependencies": {
    "@neon/realtime": "^0.2.0",
    "@vercel/functions": "^3.11.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
